{
  "compilerOptions": {
    "module": "NodeNext", // Use NodeNext or ESNext for modern ESM
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": "./src", // Explicitly define the source root directory
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "isolatedModules": true
  },
  "include": ["src/**/*"]
}
